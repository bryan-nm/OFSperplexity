#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N ofs_gen_targets
#PBS -l walltime=01:00:00
#PBS -l select=8
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q capacity
#PBS -j oe
#
# Generate OFS-head distillation targets (the exact one-at-a-time calculation) for
# a representative FASTA, sharded across tiles. This is the expensive step (~all of
# the pipeline cost); per-sequence work scales as L^2. Each rank writes its own
# `<out>.rankNNNN.pt`; pass them all to `train_head.pbs` / `ofs-pppl train --targets`.
#
# ---- Sizing (per encoder; see docs/SIZING.md for the model + calibration) --------
# Throughput ~25,000 seq / node-hour on Aurora (P~3.3e8, mean L~300, 12 tiles/node,
# 50 TFLOP/s/tile sustained, 0.7 overhead). Pick a tier and set select/walltime:
#   Minimal      25K seqs   ~1 node-hr   select=2   walltime=00:45
#   RECOMMENDED  100K seqs  ~4 node-hr   select=8   walltime=01:00   <- this script
#   Generous     500K seqs  ~20 node-hr  select=16  walltime=02:00
#   Excessive    5M seqs    ~200 node-hr select=64  walltime=04:30
# Do NOT use all of UniRef90 (~190M): the 7M-param head needs ~1e5 representative
# sequences (paper scale), not the whole database. CALIBRATE on one tile first.
#
# ---- Data prep (UniRef90) --------------------------------------------------------
# Run scripts/preprocess_uniref.pbs (or preprocess_uniref.py) FIRST to turn the raw
# uniref90.fasta.gz into the subsampled, length-filtered, shuffled FASTA used as
# INPUT below. UniRef90 already contains SwissProt -- we keep it (no exclusion).
#
# Submit from the repo root:  qsub scripts/gen_targets.pbs

cd "${PBS_O_WORKDIR:?submit with qsub from the repo root}" || exit 1

module load frameworks
source /flare/NLDesignProtein/bryan/envs/ofs-env/bin/activate

MODEL_KIND=amplify
MODEL_PATH=/flare/NLDesignProtein/bryan/models/SaAMPLIFY_350M
INPUT=/flare/NLDesignProtein/bryan/Diffusion-dev-space/datasets/uniref90_rep_le512_100k_shuf.fasta  # prepped: see header
OUT=/flare/NLDesignProtein/bryan/Diffusion-dev-space/ofs_targets/amplify_targets.pt
MAX_LEN=512

export ONEAPI_DEVICE_SELECTOR="level_zero:gpu"
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}
# --- oneCCL / fabric --------------------------------------------------------------
# gen-targets is embarrassingly parallel and, as of this version, is MPI-FREE: each
# rank reads its rank/size from the PALS_* launcher env (no mpi4py, no MPI_Init) and
# writes its own shard, so nothing opens the CXI NIC. That is the real fix for the
# "CXI alloc failed on cxiN: request exceeds ... limits" launch error. The oneCCL
# vars below are inert for this job (kept only so the same env works if you ever run
# a collective/DP path); MPICH_GPU_SUPPORT_ENABLED=0 is safe here regardless.
export CCL_PROCESS_LAUNCHER=pmix
export CCL_ATL_TRANSPORT=mpi          # CCL rides MPI's endpoints -> no separate CXI alloc
export CCL_KVS_MODE=mpi
export CCL_KVS_CONNECTION_TIMEOUT=600
export CCL_ZE_IPC_EXCHANGE=pidfd
export FI_PROVIDER=cxi
# gen-targets is embarrassingly parallel: MPI is used ONLY for host-side rank/size +
# a barrier (no GPU-aware collectives), so shed GPU-aware MPI's per-rank CXI reservations.
export MPICH_GPU_SUPPORT_ENABLED=0

RANKS_PER_NODE=12
NNODES=$(wc -l < "$PBS_NODEFILE")
NRANKS=$(( NNODES * RANKS_PER_NODE ))

echo "job=$PBS_JOBID nodes=$NNODES ranks=$NRANKS -> $OUT.rankNNNN.pt"

# Resolve python to an ABSOLUTE path from the active venv. mpiexec launches ranks
# with a fresh PATH resolution on each node; passing a bare `python` can fail to
# exec (-> exit 127, no rank output). An absolute path on /flare is visible to every
# compute node and sidesteps PATH-forwarding entirely.
PYTHON=$(command -v python)
echo "[preflight] python = $PYTHON"
# Fail fast with a clear message if the env/package isn't importable (distinguishes
# "package not installed" from "mpiexec couldn't exec python").
"$PYTHON" -c "import ofsperplexity, torch; print('[preflight] import OK; torch', torch.__version__)" \
    || { echo "[preflight] FAILED to import ofsperplexity/torch -- check the venv is activated and 'pip install -e .' ran"; exit 1; }

mpiexec -n "$NRANKS" -ppn "$RANKS_PER_NODE" --pmi=pmix --cpu-bind depth -d "$OMP_NUM_THREADS" \
    "$PYTHON" -m ofsperplexity.cli gen-targets \
        --device xpu \
        --model-kind "$MODEL_KIND" --model-path "$MODEL_PATH" \
        --input "$INPUT" --out "$OUT" --max-len "$MAX_LEN" \
        --store-dtype float16

echo "exit=$?"
